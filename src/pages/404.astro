---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" title="404" alternatePath={null}>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <p class="font-mono text-7xl font-extrabold text-accent-500">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">Página no encontrada</h1>
    <p class="mt-3">La página que buscas no existe o fue movida.</p>
    <p class="mt-1 text-zinc-500" lang="en">The page you're looking for doesn't exist or has been moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-xl bg-zinc-900 px-5 py-3 text-sm font-semibold text-white hover:bg-accent-600 dark:bg-zinc-50 dark:text-zinc-900"
      >
        Volver al inicio
      </a>
      <a
        href="/en/"
        lang="en"
        class="rounded-xl border border-zinc-300 px-5 py-3 text-sm font-semibold hover:border-zinc-900 dark:border-zinc-700 dark:hover:border-zinc-50"
      >
        Back to home
      </a>
    </div>
  </section>
</BaseLayout>
