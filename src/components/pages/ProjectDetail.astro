---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Tag from '../Tag.astro';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';
import { formatDate } from '../../utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  alternatePath: string | null;
}
const { project, lang, alternatePath } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, description, date, tags, repo, demo, role, images } = project.data;
---

<BaseLayout lang={lang} title={title} description={description} type="article" alternatePath={alternatePath}>
  <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <a
      href={localizePath('/projects', lang)}
      class="inline-flex items-center gap-2 text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-50"
    >
      <Icon name="arrow" class="size-4 rotate-180" />
      {t('project.back')}
    </a>
    <header class="mt-8 border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <time datetime={date.toISOString()} class="font-mono text-sm text-zinc-500">{formatDate(date, lang)}</time>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg">{description}</p>
      {role && <p class="mt-2 text-sm font-medium text-zinc-500">{role}</p>}
      <ul class="mt-5 flex flex-wrap gap-2">{tags.map((tag) => <li><Tag>{tag}</Tag></li>)}</ul>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold hover:border-zinc-900 dark:border-zinc-700 dark:hover:border-zinc-50"
            >
              <Icon name="github" class="size-4" /> {t('project.viewCode')}
            </a>
          )
        }
        {
          demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-accent-600 px-4 py-2 text-sm font-semibold text-white hover:bg-accent-500"
            >
              <Icon name="external" class="size-4" /> {t('project.viewDemo')}
            </a>
          )
        }
      </div>
    </header>
    {
      images.length > 0 && (
        <div class="mt-10 space-y-6">
          {images.map((img, i) => (
            <figure>
              <a
                href={img.src.src}
                target="_blank"
                rel="noopener"
                class="block overflow-hidden rounded-xl border border-zinc-200 shadow-sm dark:border-zinc-800"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  widths={[768, 1280, 1920]}
                  sizes="(min-width: 768px) 720px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </a>
              <figcaption class="mt-2 text-center text-sm text-zinc-500">{img.alt}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
