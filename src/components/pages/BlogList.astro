---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../PostItem.astro';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';
import { getPosts, groupSeries } from '../../utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = groupSeries(await getPosts(lang));
---

<BaseLayout lang={lang} title={t('nav.blog')} description={t('blogPage.description')}>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <p class="font-mono text-sm text-accent-600 dark:text-accent-400">{t('nav.blog')}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{t('blogPage.title')}</h1>
    <p class="mt-4 text-lg">
      {t('blogPage.intro')}
    </p>
    {
      posts.length > 0 ? (
        <ul class="mt-12 divide-y divide-zinc-100 dark:divide-zinc-900">
          {posts.map(({ post, parts }) => (
            <PostItem post={post} parts={parts} lang={lang} />
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-zinc-500">{t('blogPage.empty')}</p>
      )
    }
  </section>
</BaseLayout>
