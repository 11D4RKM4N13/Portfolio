---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import ProjectCard from '../ProjectCard.astro';
import PostItem from '../PostItem.astro';
import Icon from '../Icon.astro';
import { content, profile } from '../../data/site';
import { localizePath, useTranslations, withBase, type Lang } from '../../i18n/ui';
import { getPosts, groupSeries, getProjects } from '../../utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = content[lang];
const cv = profile.cv[lang] && withBase(profile.cv[lang]);

const projects = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 3);
const posts = groupSeries(await getPosts(lang)).slice(0, 3);
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2);

// Numeración de secciones (se ajusta si el blog está oculto)
let n = 0;
const num = () => `${String(++n).padStart(2, '0')}. `;
---

<BaseLayout lang={lang}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,var(--color-accent-100),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--color-accent-500)_18%,transparent),transparent_60%)]"
    >
    </div>
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-8 px-4 pt-24 pb-20 sm:px-6 sm:pt-32">
      {
        profile.available && (
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-75" />
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
            </span>
            {t('hero.available')}
          </span>
        )
      }
      <div>
        <p class="font-mono text-sm text-accent-600 dark:text-accent-400">{t('hero.greeting')}</p>
        <h1 class="mt-2 text-5xl font-extrabold tracking-tight sm:text-7xl">{profile.name}</h1>
        <p class="mt-3 text-2xl font-semibold text-zinc-500 sm:text-3xl dark:text-zinc-400">{site.role}</p>
      </div>
      <p class="max-w-2xl text-lg leading-relaxed">{site.tagline}</p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-600 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-accent-400"
        >
          {t('hero.ctaProjects')} <Icon name="arrow" class="size-4" />
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-5 py-3 text-sm font-semibold transition-colors hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-700 dark:hover:border-zinc-50 dark:hover:text-zinc-50"
        >
          {t('hero.ctaContact')}
        </a>
        {
          cv && (
            <a href={cv} download class="px-2 text-sm font-semibold underline underline-offset-4 hover:text-accent-600">
              {t('hero.cv')}
            </a>
          )
        }
        <div class="ml-1 flex items-center gap-1">
          {
            profile.socials.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="rounded-lg p-2 text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50"
              >
                <Icon name={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <dl class="mt-6 grid w-full gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-3 dark:border-zinc-800">
        {
          site.highlights.map((h) => (
            <div>
              <dt class="sr-only">{h.label}</dt>
              <dd class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">{h.value}</dd>
              <dd class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{h.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Sobre mí -->
  <Section id="about" eyebrow={num() + t('about.eyebrow')} title={t('about.title')}>
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="space-y-4 text-lg leading-relaxed">
        {site.about.map((p) => <p>{p}</p>)}
        <p class="text-base text-zinc-500">📍 {site.location}</p>
      </div>
      <div
        class="mx-auto flex size-48 items-center justify-center rounded-3xl bg-gradient-to-br from-accent-400 to-accent-600 text-6xl font-extrabold text-white shadow-2xl shadow-accent-500/20 md:mx-0"
        aria-hidden="true"
      >
        {initials}
      </div>
    </div>

    <h3 class="mt-16 mb-6 text-xl font-semibold">{t('skills.title')}</h3>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.skills.map((g) => (
          <div class="rounded-2xl border border-zinc-200 p-6 dark:border-zinc-800">
            <h4 class="mb-4 font-semibold">{g.group}</h4>
            <ul class="flex flex-wrap gap-2">
              {g.items.map((s) => (
                <li class="rounded-lg bg-zinc-100 px-2.5 py-1 text-sm dark:bg-zinc-800/80">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Experiencia -->
  <Section id="experience" eyebrow={num() + t('experience.eyebrow')} title={t('experience.title')}>
    <ol class="relative space-y-10 border-l border-zinc-200 pl-8 dark:border-zinc-800">
      {
        site.experience.map((job) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[2.4rem] size-3 rounded-full border-2 border-white bg-accent-500 ring-4 ring-accent-500/15 dark:border-zinc-950" />
            <p class="font-mono text-sm text-zinc-500">{job.period}</p>
            <h3 class="mt-1 text-lg font-semibold">
              {job.role} <span class="text-accent-600 dark:text-accent-400">· {job.company}</span>
            </h3>
            <p class="text-sm text-zinc-500">{job.place}</p>
            {job.note && <p class="mt-1 text-sm text-zinc-500 italic">{job.note}</p>}
            <ul class="mt-3 max-w-3xl list-disc space-y-1.5 pl-5 leading-relaxed text-zinc-600 marker:text-accent-500 dark:text-zinc-400">
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 grid gap-6 md:grid-cols-[2fr_1fr]">
      <div class="rounded-2xl border border-zinc-200 p-6 dark:border-zinc-800">
        <h3 class="mb-5 text-xl font-semibold">{t('education.title')}</h3>
        <ul class="space-y-5">
          {
            site.education.map((e) => (
              <li>
                <p class="font-mono text-sm text-zinc-500">{e.period}</p>
                <p class="font-semibold text-zinc-900 dark:text-zinc-100">{e.title}</p>
                <p class="text-sm text-zinc-600 dark:text-zinc-400">{e.school}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl border border-zinc-200 p-6 dark:border-zinc-800">
        <h3 class="mb-5 text-xl font-semibold">{t('languages.title')}</h3>
        <ul class="space-y-3">
          {
            site.languages.map((l) => (
              <li class="flex items-baseline justify-between gap-4">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100">{l.name}</span>
                <span class="text-sm text-zinc-500">{l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Proyectos -->
  <Section id="projects" eyebrow={num() + t('projects.eyebrow')} title={t('projects.title')}>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
    </div>
    <a
      href={localizePath('/projects', lang)}
      class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-accent-600 transition-[gap] hover:gap-3 dark:text-accent-400"
    >
      {t('projects.all')} <Icon name="arrow" class="size-4" />
    </a>
  </Section>

  <!-- Blog (solo si hay artículos en este idioma) -->
  {
    posts.length > 0 && (
      <Section id="blog" eyebrow={num() + t('blog.eyebrow')} title={t('blog.title')}>
        <ul class="divide-y divide-zinc-100 dark:divide-zinc-900">
          {posts.map(({ post, parts }) => (
            <PostItem post={post} parts={parts} lang={lang} />
          ))}
        </ul>
        <a
          href={localizePath('/blog', lang)}
          class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent-600 dark:text-accent-400"
        >
          {t('blog.all')} <Icon name="arrow" class="size-4" />
        </a>
      </Section>
    )
  }

  <!-- Contacto -->
  <Section id="contact" eyebrow={num() + t('contact.eyebrow')} title={t('contact.title')}>
    <div class="rounded-3xl border border-zinc-200 bg-zinc-50 p-8 sm:p-12 dark:border-zinc-800 dark:bg-zinc-900/50">
      <p class="max-w-xl text-lg leading-relaxed">{t('contact.body')}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-xl bg-accent-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-500"
        >
          <Icon name="mail" class="size-4" />
          {t('contact.email')}
        </a>
        <button
          id="copy-email"
          type="button"
          data-email={profile.email}
          data-copied={t('contact.copied')}
          class="rounded-xl border border-zinc-300 px-5 py-3 font-mono text-sm transition-colors hover:border-zinc-900 dark:border-zinc-700 dark:hover:border-zinc-50"
        >
          {profile.email}
        </button>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('copy-email');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        btn.textContent = btn.dataset.copied ?? '✓';
        setTimeout(() => (btn.textContent = email), 1800);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });
</script>
