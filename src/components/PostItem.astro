---
import type { CollectionEntry } from 'astro:content';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { entrySlug, formatDate } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  // Partes de la serie en orden de lectura (ver groupSeries). Vacío para un artículo suelto.
  parts?: CollectionEntry<'blog'>[];
}
const { post, lang, parts = [] } = Astro.props;
const t = useTranslations(lang);
const href = (p: CollectionEntry<'blog'>) => localizePath(`/blog/${entrySlug(p)}`, lang);
const first = parts[0];
// "Serie: tema" → "tema", para no repetir el nombre de la serie en cada parte
const partTitle = (p: CollectionEntry<'blog'>) => {
  const prefix = `${p.data.series}: `;
  if (!p.data.title.startsWith(prefix)) return p.data.title;
  const rest = p.data.title.slice(prefix.length);
  return rest.charAt(0).toUpperCase() + rest.slice(1);
};
---

{
  first ? (
    <li class="-mx-4 flex flex-col gap-1 px-4 py-4 sm:flex-row sm:items-baseline sm:gap-6">
      <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-sm text-zinc-500 sm:w-32">
        {formatDate(post.data.date, lang)}
      </time>
      <div>
        <p class="font-mono text-xs text-accent-600 dark:text-accent-400">
          {t('post.series')} · {parts.length} {t('post.parts')}
        </p>
        <h3 class="mt-1 font-semibold">
          <a href={href(first)} class="transition-colors hover:text-accent-600 dark:hover:text-accent-400">
            {first.data.series}
          </a>
        </h3>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{first.data.description}</p>
        <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
          {parts.map((p) => (
            <li>
              <a href={href(p)} class="hover:text-accent-600 dark:hover:text-accent-400">
                {partTitle(p)}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </li>
  ) : (
    <li>
      <a
        href={href(post)}
        class="group -mx-4 flex flex-col gap-1 rounded-xl px-4 py-4 transition-colors hover:bg-zinc-50 sm:flex-row sm:items-baseline sm:gap-6 dark:hover:bg-zinc-900"
      >
        <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-sm text-zinc-500 sm:w-32">
          {formatDate(post.data.date, lang)}
        </time>
        <div>
          <h3 class="font-semibold transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400">
            {post.data.title}
          </h3>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
        </div>
      </a>
    </li>
  )
}
