---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  class?: string;
}
const { id, eyebrow, title, class: className } = Astro.props;
---

<section id={id} class:list={['reveal mx-auto max-w-5xl px-4 py-20 sm:px-6', className]}>
  {eyebrow && <p class="mb-2 font-mono text-sm text-accent-600 dark:text-accent-400">{eyebrow}</p>}
  <h2 class="mb-10 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  <slot />
</section>
